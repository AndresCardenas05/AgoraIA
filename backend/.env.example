# ==============================================================================
# Configuración de ÁgoraIA - Chatbot RAG de Ética Periodística e IA
# ==============================================================================

# Identidad de la aplicación
APP_NAME=ÁgoraIA
APP_VERSION=1.0.0
ENVIRONMENT=development

# Proveedor de LLM: "openai" o "gemini"
LLM_PROVIDER=openai
OPENAI_LLM_MODEL=gpt-4o-mini
GEMINI_LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Credenciales de API (configurar según el proveedor elegido)
OPENAI_API_KEY=sk-reemplazar-con-tu-clave-openai
GOOGLE_API_KEY=reemplazar-con-tu-clave-gemini

# Proveedor de Embeddings: "huggingface" (local multilingüe/español) o "openai"
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Parámetros de Chunking (coherencia de artículos legales)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Parámetros de Recuperación y Regla "Cero Alucinaciones"
TOP_K=5
SIMILARITY_SCORE_THRESHOLD=0.45

# Almacenamiento ChromaDB y PDFs
CHROMA_COLLECTION_NAME=agora_ia_etica_periodistica
PDF_DIRECTORY=./data/pdfs
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
